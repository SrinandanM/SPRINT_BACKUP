<mvc:View
    controllerName="asset.lifecycle.portal.adminportal.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <Page
        id="portalPage"
        title="Asset Lifecycle Management Portal"
        enableScrolling="true"
        showHeader="true">

        <!-- TOP HEADER -->
        <headerContent>
            <HBox width="100%" alignItems="Center" justifyContent="SpaceBetween" class="portalHeader">
                <Button
                    id="menuToggleBtn"
                    icon="sap-icon://menu"
                    type="Transparent"
                    press=".onMenuToggle"
                    tooltip="Toggle Menu"
                    class="menuToggleButton" />
                <Title
                    text="Asset Lifecycle Management Portal"
                    level="H1"
                    titleStyle="H1"
                    class="portalTitle" />
                <VBox width="48px" />
            </HBox>
        </headerContent>

        <!-- MAIN CONTENT -->
        <content>
            <HBox width="100%" renderType="Bare" class="mainContainer">
                
                <!-- COLLAPSIBLE SIDEBAR -->
                <VBox
                    id="sidebarContainer"
                    width="280px"
                    class="collapsibleSidebar"
                    visible="false">

                    <List
                        id="navigationMenu"
                        width="100%"
                        mode="SingleSelectMaster"
                        selectionChange=".onMenuSelect"
                        showSeparators="None"
                        class="sidebarMenu">

                        <StandardListItem
                            id="dashboardItem"
                            title="Dashboard"
                            icon="sap-icon://home"
                            type="Active"
                            class="sidebarMenuItem" />

                        <StandardListItem
                            id="assetsItem"
                            title="Assets"
                            icon="sap-icon://laptop"
                            type="Active"
                            class="sidebarMenuItem" />

                        <StandardListItem
                            id="requestsItem"
                            title="Asset Requests"
                            icon="sap-icon://workflow-tasks"
                            type="Active"
                            class="sidebarMenuItem" />

                        <StandardListItem
                            id="employeesItem"
                            title="Employees"
                            icon="sap-icon://employee"
                            type="Active"
                            class="sidebarMenuItem" />

                        <StandardListItem
                            id="departmentsItem"
                            title="Departments"
                            icon="sap-icon://building"
                            type="Active"
                            class="sidebarMenuItem" />

                        <StandardListItem
                            id="vendorsItem"
                            title="Vendors"
                            icon="sap-icon://supplier"
                            type="Active"
                            class="sidebarMenuItem" />

                        <StandardListItem
                            id="categoriesItem"
                            title="Categories"
                            icon="sap-icon://tag"
                            type="Active"
                            class="sidebarMenuItem" />

                        <StandardListItem
                            id="reportsItem"
                            title="Reports"
                            icon="sap-icon://business-objects-experience"
                            type="Active"
                            class="sidebarMenuItem" />

                    </List>

                </VBox>

                <!-- MAIN CONTENT AREA -->
                <VBox
                    id="contentArea"
                    width="100%"
                    class="contentAreaMain">

                    <!-- ===== DASHBOARD - FULL WIDTH ===== -->
                    <VBox
                        id="dashboardContainer"
                        visible="true"
                        width="100%"
                        class="contentPage dashboardPage">

                        <!-- HEADER -->
                        <VBox class="dashboardHeader" class="pageHeader">
                            <Title
                                text="Enterprise Asset Management Dashboard"
                                level="H1"
                                titleStyle="H1"
                                class="dashboardTitle" />
                            <Text
                                text="Real-Time Asset Lifecycle Monitoring"
                                class="dashboardSubtitle" />
                        </VBox>

                        <!-- KPI SECTION -->
                        <VBox class="kpiSection">
                            <Title
                                text="Asset Overview"
                                level="H2"
                                titleStyle="H2"
                                class="sectionTitle" />

                            <HBox
                                justifyContent="Center"
                                wrap="Wrap"
                                class="kpiContainer">

                                <GenericTile
                                    header="Total Assets"
                                    class="kpiTile">
                                    <TileContent>
                                        <NumericContent 
                                            value="{kpi>/totalAssets}"
                                            valueColor="Good" />
                                    </TileContent>
                                </GenericTile>

                                <GenericTile
                                    header="Available Assets"
                                    class="kpiTile">
                                    <TileContent>
                                        <NumericContent 
                                            value="{kpi>/availableAssets}"
                                            valueColor="Good" />
                                    </TileContent>
                                </GenericTile>

                                <GenericTile
                                    header="Assigned Assets"
                                    class="kpiTile">
                                    <TileContent>
                                        <NumericContent 
                                            value="{kpi>/assignedAssets}"
                                            valueColor="Neutral" />
                                    </TileContent>
                                </GenericTile>

                                <GenericTile
                                    header="Maintenance Assets"
                                    class="kpiTile">
                                    <TileContent>
                                        <NumericContent 
                                            value="{kpi>/maintenanceAssets}"
                                            valueColor="Critical" />
                                    </TileContent>
                                </GenericTile>

                                <GenericTile
                                    header="Retired Assets"
                                    class="kpiTile">
                                    <TileContent>
                                        <NumericContent 
                                            value="{kpi>/retiredAssets}"
                                            valueColor="Error" />
                                    </TileContent>
                                </GenericTile>

                                <GenericTile
                                    header="Archived Assets"
                                    class="kpiTile">
                                    <TileContent>
                                        <NumericContent 
                                            value="{kpi>/archivedAssets}"
                                            valueColor="Neutral" />
                                    </TileContent>
                                </GenericTile>

                            </HBox>
                        </VBox>

                        <!-- CHARTS ROW 1 -->
                        <HBox
                            justifyContent="SpaceAround"
                            wrap="Wrap"
                            class="chartsRow">

                            <!-- STATUS CHART -->
                            <VBox width="48%" class="chartContainer">
                                <Title
                                    text="Assets By Status"
                                    level="H2"
                                    titleStyle="H2"
                                    class="chartTitle" />

                                <viz:VizFrame
                                    vizType="donut"
                                    width="100%"
                                    height="400px"
                                    class="vizChart">

                                    <viz:dataset>
                                        <viz.data:FlattenedDataset
                                            data="{status>/}">

                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition
                                                    name="Status"
                                                    value="{status>status}" />
                                            </viz.data:dimensions>

                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition
                                                    name="Assets"
                                                    value="{status>assetCount}" />
                                            </viz.data:measures>

                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>

                                    <viz:feeds>
                                        <viz.feeds:FeedItem
                                            uid="size"
                                            type="Measure"
                                            values="Assets" />
                                        <viz.feeds:FeedItem
                                            uid="color"
                                            type="Dimension"
                                            values="Status" />
                                    </viz:feeds>

                                </viz:VizFrame>
                            </VBox>

                            <!-- CATEGORY CHART -->
                            <VBox width="48%" class="chartContainer">
                                <Title
                                    text="Assets By Category"
                                    level="H2"
                                    titleStyle="H2"
                                    class="chartTitle" />

                                <viz:VizFrame
                                    vizType="column"
                                    width="100%"
                                    height="400px"
                                    class="vizChart">

                                    <viz:dataset>
                                        <viz.data:FlattenedDataset
                                            data="{category>/}">

                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition
                                                    name="Category"
                                                    value="{category>categoryName}" />
                                            </viz.data:dimensions>

                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition
                                                    name="Assets"
                                                    value="{category>assetCount}" />
                                            </viz.data:measures>

                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>

                                    <viz:feeds>
                                        <viz.feeds:FeedItem
                                            uid="valueAxis"
                                            type="Measure"
                                            values="Assets" />
                                        <viz.feeds:FeedItem
                                            uid="categoryAxis"
                                            type="Dimension"
                                            values="Category" />
                                    </viz:feeds>

                                </viz:VizFrame>
                            </VBox>

                        </HBox>

                        <!-- CHARTS ROW 2 -->
                        <VBox class="chartsRow">
                            <Title
                                text="Assets By Department"
                                level="H2"
                                titleStyle="H2"
                                class="chartTitle" />

                            <viz:VizFrame
                                vizType="bar"
                                width="100%"
                                height="400px"
                                class="vizChart">

                                <viz:dataset>
                                    <viz.data:FlattenedDataset
                                        data="{department>/}">

                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition
                                                name="Department"
                                                value="{department>departmentName}" />
                                        </viz.data:dimensions>

                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition
                                                name="Assets"
                                                value="{department>assetCount}" />
                                        </viz.data:measures>

                                    </viz.data:FlattenedDataset>
                                </viz:dataset>

                                <viz:feeds>
                                    <viz.feeds:FeedItem
                                        uid="valueAxis"
                                        type="Measure"
                                        values="Assets" />
                                    <viz.feeds:FeedItem
                                        uid="categoryAxis"
                                        type="Dimension"
                                        values="Department" />
                                </viz:feeds>

                            </viz:VizFrame>
                        </VBox>

                    </VBox>

                    <!-- ===== ASSETS PAGE ===== -->
                    <VBox
                        id="assetsContainer"
                        visible="false"
                        width="100%"
                        class="contentPage">

                        <Toolbar class="pageToolbar">
                            <Title text="Asset Management" level="H2" titleStyle="H2" />
                        </Toolbar>

                        <core:HTML
                            id="assetsHtml"
                            content="&lt;iframe src='/adminasset/index.html' style='width:100%;height:calc(100vh - 100px);border:none;border-radius:8px;'&gt;&lt;/iframe&gt;" />

                    </VBox>

                    <!-- ===== REQUESTS PAGE ===== -->
                    <VBox
                        id="requestsContainer"
                        visible="false"
                        width="100%"
                        class="contentPage">

                        <Toolbar class="pageToolbar">
                            <Title text="Asset Requests" level="H2" titleStyle="H2" />
                        </Toolbar>

                    </VBox>

                    <!-- ===== EMPLOYEES PAGE ===== -->
                    <VBox
                        id="employeesContainer"
                        visible="false"
                        width="100%"
                        class="contentPage">

                        <Toolbar class="pageToolbar">
                            <Title text="Employees" level="H2" titleStyle="H2" />
                        </Toolbar>

                    </VBox>

                    <!-- ===== DEPARTMENTS PAGE ===== -->
                    <VBox
                        id="departmentsContainer"
                        visible="false"
                        width="100%"
                        class="contentPage">

                        <Toolbar class="pageToolbar">
                            <Title text="Departments" level="H2" titleStyle="H2" />
                        </Toolbar>

                    </VBox>

                    <!-- ===== VENDORS PAGE ===== -->
                    <VBox
                        id="vendorsContainer"
                        visible="false"
                        width="100%"
                        class="contentPage">

                        <Toolbar class="pageToolbar">
                            <Title text="Vendors" level="H2" titleStyle="H2" />
                        </Toolbar>

                    </VBox>

                    <!-- ===== CATEGORIES PAGE ===== -->
                    <VBox
                        id="categoriesContainer"
                        visible="false"
                        width="100%"
                        class="contentPage">

                        <Toolbar class="pageToolbar">
                            <Title text="Categories" level="H2" titleStyle="H2" />
                        </Toolbar>

                    </VBox>

                    <!-- ===== REPORTS PAGE ===== -->
                    <VBox
                        id="reportsContainer"
                        visible="false"
                        width="100%"
                        class="contentPage">

                        <Toolbar class="pageToolbar">
                            <Title text="Reports" level="H2" titleStyle="H2" />
                        </Toolbar>

                    </VBox>

                </VBox>

            </HBox>
        </content>

    </Page>

</mvc:View>
