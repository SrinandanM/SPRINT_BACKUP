<mvc:View
    controllerName="asset.lifecycle.portal.adminportal.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <Page
        id="portalPage"
        enableScrolling="true"
        showHeader="false">

        <!-- TOP NAVIGATION BAR -->
        <headerContent>
            <VBox width="100%" class="navBar">
                <HBox width="100%" alignItems="Center" class="navBarContent">
                    <Button
                        id="menuToggleBtn"
                        icon="sap-icon://menu"
                        type="Transparent"
                        press=".onMenuToggle"
                        tooltip="Toggle Menu"
                        class="navButton" />
                    <Title
                        text="Asset Lifecycle Management"
                        level="H1"
                        titleStyle="H1"
                        class="navTitle" />
                    <ToolbarSpacer />
                    <Button
                        icon="sap-icon://bell"
                        type="Transparent"
                        class="navButton" />
                    <Button
                        icon="sap-icon://user-settings"
                        type="Transparent"
                        class="navButton" />
                </HBox>
            </VBox>
        </headerContent>

        <!-- MAIN LAYOUT -->
        <content>
            <HBox width="100%" height="100%" renderType="Bare" class="mainLayout">
                
                <!-- SIDEBAR MENU -->
                <VBox
                    id="sidebarContainer"
                    width="260px"
                    class="sidebar"
                    visible="false">
                    
                    <List
                        id="navigationMenu"
                        width="100%"
                        mode="SingleSelectMaster"
                        selectionChange=".onMenuSelect"
                        showSeparators="None"
                        class="navMenu">

                        <StandardListItem
                            id="dashboardItem"
                            title="Dashboard"
                            icon="sap-icon://home"
                            type="Active"
                            class="navItem" />

                        <StandardListItem
                            id="assetsItem"
                            title="Assets"
                            icon="sap-icon://laptop"
                            type="Active"
                            class="navItem" />

                        <StandardListItem
                            id="requestsItem"
                            title="Requests"
                            icon="sap-icon://workflow-tasks"
                            type="Active"
                            class="navItem" />

                        <StandardListItem
                            id="employeesItem"
                            title="Employees"
                            icon="sap-icon://employee"
                            type="Active"
                            class="navItem" />

                        <StandardListItem
                            id="departmentsItem"
                            title="Departments"
                            icon="sap-icon://building"
                            type="Active"
                            class="navItem" />

                        <StandardListItem
                            id="vendorsItem"
                            title="Vendors"
                            icon="sap-icon://supplier"
                            type="Active"
                            class="navItem" />

                        <StandardListItem
                            id="categoriesItem"
                            title="Categories"
                            icon="sap-icon://tag"
                            type="Active"
                            class="navItem" />

                        <StandardListItem
                            id="reportsItem"
                            title="Reports"
                            icon="sap-icon://business-objects-experience"
                            type="Active"
                            class="navItem" />

                    </List>
                </VBox>

                <!-- MAIN CONTENT -->
                <ScrollContainer
                    id="contentScroll"
                    width="100%"
                    height="100%"
                    horizontal="false"
                    vertical="true"
                    class="contentContainer">

                    <!-- DASHBOARD VIEW -->
                    <VBox
                        id="dashboardContainer"
                        visible="true"
                        width="100%"
                        class="pageContent">

                        <!-- KPI METRICS SECTION -->
                        <VBox class="metricsSection">
                            <HBox width="100%" class="metricsGrid" wrapping="true">
                                
                                <VBox class="metricCard">
                                    <HBox class="metricHeader">
                                        <Icon src="sap-icon://cart-4" class="metricIcon" />
                                        <Title text="Total Assets" level="H4" class="metricTitle" />
                                    </HBox>
                                    <ObjectNumber
                                        number="{kpi>/totalAssets}"
                                        numberState="Neutral"
                                        class="metricValue" />
                                    <Text text="All Assets in System" class="metricLabel" />
                                </VBox>

                                <VBox class="metricCard">
                                    <HBox class="metricHeader">
                                        <Icon src="sap-icon://accept" class="metricIcon" />
                                        <Title text="Available" level="H4" class="metricTitle" />
                                    </HBox>
                                    <ObjectNumber
                                        number="{kpi>/availableAssets}"
                                        numberState="Success"
                                        class="metricValue" />
                                    <Text text="Ready for Deployment" class="metricLabel" />
                                </VBox>

                                <VBox class="metricCard">
                                    <HBox class="metricHeader">
                                        <Icon src="sap-icon://assigned-task" class="metricIcon" />
                                        <Title text="Assigned" level="H4" class="metricTitle" />
                                    </HBox>
                                    <ObjectNumber
                                        number="{kpi>/assignedAssets}"
                                        numberState="Information"
                                        class="metricValue" />
                                    <Text text="In Use" class="metricLabel" />
                                </VBox>

                                <VBox class="metricCard">
                                    <HBox class="metricHeader">
                                        <Icon src="sap-icon://tools-2" class="metricIcon" />
                                        <Title text="Maintenance" level="H4" class="metricTitle" />
                                    </HBox>
                                    <ObjectNumber
                                        number="{kpi>/maintenanceAssets}"
                                        numberState="Warning"
                                        class="metricValue" />
                                    <Text text="Service in Progress" class="metricLabel" />
                                </VBox>

                                <VBox class="metricCard">
                                    <HBox class="metricHeader">
                                        <Icon src="sap-icon://delete" class="metricIcon" />
                                        <Title text="Retired" level="H4" class="metricTitle" />
                                    </HBox>
                                    <ObjectNumber
                                        number="{kpi>/retiredAssets}"
                                        numberState="Error"
                                        class="metricValue" />
                                    <Text text="End of Life" class="metricLabel" />
                                </VBox>

                                <VBox class="metricCard">
                                    <HBox class="metricHeader">
                                        <Icon src="sap-icon://archive" class="metricIcon" />
                                        <Title text="Archived" level="H4" class="metricTitle" />
                                    </HBox>
                                    <ObjectNumber
                                        number="{kpi>/archivedAssets}"
                                        numberState="Neutral"
                                        class="metricValue" />
                                    <Text text="Historical Records" class="metricLabel" />
                                </VBox>

                            </HBox>
                        </VBox>

                        <!-- CHARTS SECTION -->
                        <VBox class="chartsSection">
                            <HBox width="100%" class="chartsGrid">
                                
                                <!-- STATUS CHART -->
                                <VBox class="chartBox" width="49%">
                                    <VBox class="chartHeader">
                                        <Title text="Asset Distribution by Status" level="H3" titleStyle="H3" class="chartTitle" />
                                        <Text text="Status breakdown across all assets" class="chartDescription" />
                                    </VBox>
                                    <viz:VizFrame
                                        vizType="donut"
                                        width="100%"
                                        height="380px"
                                        class="vizChart">
                                        <viz:dataset>
                                            <viz.data:FlattenedDataset data="{status>/}">
                                                <viz.data:dimensions>
                                                    <viz.data:DimensionDefinition name="Status" value="{status>status}" />
                                                </viz.data:dimensions>
                                                <viz.data:measures>
                                                    <viz.data:MeasureDefinition name="Count" value="{status>assetCount}" />
                                                </viz.data:measures>
                                            </viz.data:FlattenedDataset>
                                        </viz:dataset>
                                        <viz:feeds>
                                            <viz.feeds:FeedItem uid="size" type="Measure" values="Count" />
                                            <viz.feeds:FeedItem uid="color" type="Dimension" values="Status" />
                                        </viz:feeds>
                                    </viz:VizFrame>
                                </VBox>

                                <!-- CATEGORY CHART -->
                                <VBox class="chartBox" width="49%">
                                    <VBox class="chartHeader">
                                        <Title text="Asset Distribution by Category" level="H3" titleStyle="H3" class="chartTitle" />
                                        <Text text="Breakdown across asset categories" class="chartDescription" />
                                    </VBox>
                                    <viz:VizFrame
                                        vizType="column"
                                        width="100%"
                                        height="380px"
                                        class="vizChart">
                                        <viz:dataset>
                                            <viz.data:FlattenedDataset data="{category>/}">
                                                <viz.data:dimensions>
                                                    <viz.data:DimensionDefinition name="Category" value="{category>categoryName}" />
                                                </viz.data:dimensions>
                                                <viz.data:measures>
                                                    <viz.data:MeasureDefinition name="Count" value="{category>assetCount}" />
                                                </viz.data:measures>
                                            </viz.data:FlattenedDataset>
                                        </viz:dataset>
                                        <viz:feeds>
                                            <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Count" />
                                            <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Category" />
                                        </viz:feeds>
                                    </viz:VizFrame>
                                </VBox>

                            </HBox>

                            <!-- DEPARTMENT CHART - FULL WIDTH -->
                            <VBox class="chartBox" width="100%">
                                <VBox class="chartHeader">
                                    <Title text="Asset Distribution by Department" level="H3" titleStyle="H3" class="chartTitle" />
                                    <Text text="Departmental asset allocation overview" class="chartDescription" />
                                </VBox>
                                <viz:VizFrame
                                    vizType="bar"
                                    width="100%"
                                    height="380px"
                                    class="vizChart">
                                    <viz:dataset>
                                        <viz.data:FlattenedDataset data="{department>/}">
                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition name="Department" value="{department>departmentName}" />
                                            </viz.data:dimensions>
                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition name="Count" value="{department>assetCount}" />
                                            </viz.data:measures>
                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Count" />
                                        <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Department" />
                                    </viz:feeds>
                                </viz:VizFrame>
                            </VBox>

                        </VBox>

                    </VBox>

                    <!-- OTHER PAGES (ASSETS, REQUESTS, etc.) -->
                    <VBox id="assetsContainer" visible="false" width="100%" class="pageContent">
                        <VBox class="pageHeader">
                            <Title text="Asset Management" level="H2" titleStyle="H2" />
                            <Text text="Manage and track all assets in the system" />
                        </VBox>
                    </VBox>

                    <VBox id="requestsContainer" visible="false" width="100%" class="pageContent">
                        <VBox class="pageHeader">
                            <Title text="Asset Requests" level="H2" titleStyle="H2" />
                            <Text text="Manage asset requests and approvals" />
                        </VBox>
                    </VBox>

                    <VBox id="employeesContainer" visible="false" width="100%" class="pageContent">
                        <VBox class="pageHeader">
                            <Title text="Employees" level="H2" titleStyle="H2" />
                            <Text text="Manage employee information and asset assignments" />
                        </VBox>
                    </VBox>

                    <VBox id="departmentsContainer" visible="false" width="100%" class="pageContent">
                        <VBox class="pageHeader">
                            <Title text="Departments" level="H2" titleStyle="H2" />
                            <Text text="Manage department records" />
                        </VBox>
                    </VBox>

                    <VBox id="vendorsContainer" visible="false" width="100%" class="pageContent">
                        <VBox class="pageHeader">
                            <Title text="Vendors" level="H2" titleStyle="H2" />
                            <Text text="Manage vendor information" />
                        </VBox>
                    </VBox>

                    <VBox id="categoriesContainer" visible="false" width="100%" class="pageContent">
                        <VBox class="pageHeader">
                            <Title text="Categories" level="H2" titleStyle="H2" />
                            <Text text="Manage asset categories" />
                        </VBox>
                    </VBox>

                    <VBox id="reportsContainer" visible="false" width="100%" class="pageContent">
                        <VBox class="pageHeader">
                            <Title text="Reports" level="H2" titleStyle="H2" />
                            <Text text="Generate and view asset reports" />
                        </VBox>
                    </VBox>

                </ScrollContainer>

            </HBox>
        </content>

    </Page>

</mvc:View>
