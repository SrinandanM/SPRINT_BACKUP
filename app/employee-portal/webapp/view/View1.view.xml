<mvc:View
    controllerName="employeeportal.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="employeePage"
        title="Employee Portal"
        enableScrolling="true"
        class="sapUiResponsiveContentPadding">

        <headerContent>
            <HBox width="100%" alignItems="Center" justifyContent="SpaceBetween">
                <Button
                    id="menuToggleBtn"
                    icon="sap-icon://menu"
                    type="Transparent"
                    press=".onMenuToggle"
                    tooltip="Toggle Menu" />
                <Title
                    text="Asset Lifecycle Management Portal"
                    level="H1"
                    titleStyle="H1"
                    class="menuTitle" />
                <HBox width="50px" />
            </HBox>
        </headerContent>

        <content>

            <HBox
                id="mainLayout"
                width="100%"
                renderType="Bare">

                <!-- COLLAPSIBLE SIDEBAR -->

                <VBox
                    id="sidebarContainer"
                    width="280px"
                    class="modernSidebar"
                    visible="true">

                    <List
                        id="navigationMenu"
                        width="100%"
                        mode="SingleSelectMaster"
                        selectionChange=".onMenuSelect"
                        showSeparators="Inner">

                        <StandardListItem
                            id="dashboardItem"
                            title="Dashboard"
                            icon="sap-icon://home"
                            type="Active"
                            class="sidebarItem" />

                        <StandardListItem
                            id="assetsItem"
                            title="My Assets"
                            icon="sap-icon://laptop"
                            type="Active"
                            class="sidebarItem" />

                        <StandardListItem
                            id="requestsItem"
                            title="My Requests"
                            icon="sap-icon://workflow-tasks"
                            type="Active"
                            class="sidebarItem" />

                        <StandardListItem
                            id="profileItem"
                            title="My Profile"
                            icon="sap-icon://employee"
                            type="Active"
                            class="sidebarItem" />

                    </List>

                </VBox>

                <!-- MODERN CONTENT AREA -->

                <VBox
                    id="contentArea"
                    width="100%"
                    class="sapUiResponsiveContentPadding modernContent">

                    <!-- DASHBOARD -->

                    <VBox
                        id="dashboardContainer"
                        visible="true">

                        <Title
                            id="dashboardTitle"
                            text="Dashboard"
                            level="H2"
                            titleStyle="H2"
                            class="sapUiLargeMarginBottom sapUiLargeMarginTop" />

                        <!-- STATISTICS CARDS -->

                        <HBox
                            class="statisticsRow">

                            <VBox
                                class="statisticCard">
                                <ObjectNumber
                                    number="{/assignedAssets}"
                                    unit="Assets Assigned"
                                    class="cardNumber" />
                                <Text
                                    text="Currently in Use"
                                    class="cardLabel" />
                            </VBox>

                            <VBox
                                class="statisticCard">
                                <ObjectNumber
                                    number="{/pendingRequests}"
                                    unit="Pending Requests"
                                    class="cardNumber" />
                                <Text
                                    text="Awaiting Approval"
                                    class="cardLabel" />
                            </VBox>

                            <VBox
                                class="statisticCard">
                                <ObjectNumber
                                    number="{/maintenanceAssets}"
                                    unit="In Maintenance"
                                    class="cardNumber" />
                                <Text
                                    text="Service in Progress"
                                    class="cardLabel" />
                            </VBox>

                        </HBox>

                        <!-- ASSET LIFESPAN SLIDER -->

                        <Panel
                            headerText="Asset Lifecycle Tracker"
                            class="sliderPanel"
                            expandable="true"
                            expanded="true">

                            <VBox
                                class="sliderContainer">

                                <Title
                                    text="Asset Warranty Coverage"
                                    level="H4"
                                    class="sliderTitle" />

                                <Text
                                    text="Monitor your asset warranty period below:"
                                    class="sliderDescription" />

                                <!-- WARRANTY SLIDER -->

                                <VBox
                                    class="sliderItem"
                                    style="margin-top: 20px">

                                    <HBox
                                        justifyContent="SpaceBetween">

                                        <Label
                                            text="Warranty Progress"
                                            class="sliderLabel" />

                                        <Text
                                            text="{/warrantyPercentage}%"
                                            class="sliderValue" />

                                    </HBox>

                                    <Slider
                                        id="warrantySlider"
                                        value="{/warrantyPercentage}"
                                        enabled="false"
                                        class="assetSlider"
                                        width="100%"
                                        step="1"
                                        min="0"
                                        max="100" />

                                </VBox>

                                <!-- DEPRECIATION SLIDER -->

                                <VBox
                                    class="sliderItem"
                                    style="margin-top: 24px">

                                    <HBox
                                        justifyContent="SpaceBetween">

                                        <Label
                                            text="Asset Depreciation"
                                            class="sliderLabel" />

                                        <Text
                                            text="{/depreciationPercentage}%"
                                            class="sliderValue" />

                                    </HBox>

                                    <Slider
                                        id="depreciationSlider"
                                        value="{/depreciationPercentage}"
                                        enabled="false"
                                        class="assetSlider"
                                        width="100%"
                                        step="1"
                                        min="0"
                                        max="100" />

                                </VBox>

                                <!-- MAINTENANCE LIFESPAN SLIDER -->

                                <VBox
                                    class="sliderItem"
                                    style="margin-top: 24px">

                                    <HBox
                                        justifyContent="SpaceBetween">

                                        <Label
                                            text="Maintenance Schedule (Months)"
                                            class="sliderLabel" />

                                        <Text
                                            text="{/maintenanceMonths}"
                                            class="sliderValue" />

                                    </HBox>

                                    <Slider
                                        id="maintenanceSlider"
                                        value="{/maintenanceMonths}"
                                        enabled="false"
                                        class="assetSlider"
                                        width="100%"
                                        step="1"
                                        min="0"
                                        max="60" />

                                </VBox>

                            </VBox>

                        </Panel>

                    </VBox>

                    <!-- MY ASSETS -->

                    <VBox
                        id="assetsContainer"
                        visible="false">

                        <Title
                            id="assetsTitle"
                            text="My Assets"
                            level="H2"
                            titleStyle="H2"
                            class="sapUiLargeMarginBottom sapUiLargeMarginTop" />

                        <Toolbar
                            class="modernToolbar">

                            <SearchField
                                width="320px"
                                liveChange=".onAssetSearch"
                                placeholder="Search Assets"
                                class="modernSearch" />

                            <ToolbarSpacer />

                            <Button
                                text="Request Asset"
                                type="Emphasized"
                                icon="sap-icon://add"
                                press=".onRequestAsset" />

                        </Toolbar>

                        <Table
                            id="assetTable"
                            growing="true"
                            sticky="ColumnHeaders"
                            items="{assets>/}"
                            class="modernTable">

                            <columns>

                                <Column>
                                    <Text text="Asset Tag" />
                                </Column>

                                <Column>
                                    <Text text="Model" />
                                </Column>

                                <Column>
                                    <Text text="Status" />
                                </Column>

                                <Column>
                                    <Text text="Serial Number" />
                                </Column>

                                <Column>
                                    <Text text="Category" />
                                </Column>

                            </columns>

                            <items>

                                <ColumnListItem>

                                    <cells>

                                        <Text
                                            text="{assets>assetTag}"
                                            class="assetTagHighlight" />

                                        <Text
                                            text="{assets>model}" />

                                        <ObjectStatus
                                            text="{assets>status}"
                                            state="{
                                                path: 'assets>status',
                                                formatter: '.formatStatusState'
                                            }" />

                                        <Text
                                            text="{assets>serialNumber}" />

                                        <Text
                                            text="{assets>categoryName}" />

                                    </cells>

                                </ColumnListItem>

                            </items>

                        </Table>

                    </VBox>

                    <!-- MY REQUESTS -->

                    <VBox
                        id="requestsContainer"
                        visible="false">

                        <Title
                            id="requestsTitle"
                            text="My Requests"
                            level="H2"
                            titleStyle="H2"
                            class="sapUiLargeMarginBottom sapUiLargeMarginTop" />

                        <Toolbar
                            class="modernToolbar">

                            <Button
                                text="New Request"
                                type="Emphasized"
                                icon="sap-icon://add"
                                press=".onNewRequest" />

                            <ToolbarSpacer />

                            <SearchField
                                width="320px"
                                liveChange=".onRequestSearch"
                                placeholder="Search Requests"
                                class="modernSearch" />

                        </Toolbar>

                        <Table
                            id="requestTable"
                            growing="true"
                            sticky="ColumnHeaders"
                            items="{requests>/}"
                            class="modernTable">

                            <columns>

                                <Column>
                                    <Text text="Category" />
                                </Column>

                                <Column>
                                    <Text text="Justification" />
                                </Column>

                                <Column>
                                    <Text text="Status" />
                                </Column>

                                <Column>
                                    <Text text="Approval Date" />
                                </Column>

                                <Column>
                                    <Text text="Remarks" />
                                </Column>

                            </columns>

                            <items>

                                <ColumnListItem>

                                    <cells>

                                        <Text
                                            text="{requests>categoryName}" />

                                        <Text
                                            text="{requests>justification}" />

                                        <ObjectStatus
                                            text="{requests>status}"
                                            state="{
                                                path: 'requests>status',
                                                formatter: '.formatRequestStatus'
                                            }" />

                                        <Text
                                            text="{requests>approvalDate}" />

                                        <Text
                                            text="{requests>remarks}" />

                                    </cells>

                                </ColumnListItem>

                            </items>

                        </Table>

                    </VBox>

                    <!-- PROFILE -->

                    <VBox
                        id="profileContainer"
                        visible="false">

                        <Title
                            id="profileTitle"
                            text="My Profile"
                            level="H2"
                            titleStyle="H2"
                            class="sapUiLargeMarginBottom sapUiLargeMarginTop" />

                        <Panel
                            headerText="Employee Information"
                            class="profilePanel">

                            <Form
                                editable="false">

                                <FormContainer>

                                    <FormElement>
                                        <Label text="Full Name" />
                                        <Text text="{/employeeName}" />
                                    </FormElement>

                                    <FormElement>
                                        <Label text="Employee Number" />
                                        <Text text="{/employeeNumber}" />
                                    </FormElement>

                                    <FormElement>
                                        <Label text="Email" />
                                        <Text text="{/email}" />
                                    </FormElement>

                                    <FormElement>
                                        <Label text="Department" />
                                        <Text text="{/department}" />
                                    </FormElement>

                                    <FormElement>
                                        <Label text="Role" />
                                        <Text text="{/role}" />
                                    </FormElement>

                                </FormContainer>

                            </Form>

                        </Panel>

                    </VBox>

                </VBox>

            </HBox>

        </content>

    </Page>

</mvc:View>
